{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etzhayyim-open-airplane",
  // Compiled from src/open_airplane/worker.cljs by shadow-cljs (:target :esm).
  // Before the cljs migration this pointed at "svelte/.svelte-kit/cloudflare/
  // _worker.js" -- a SvelteKit build output that is not in the tree -- and the
  // TypeScript a reader opened (worker/src/app.ts) was in no bundle at all.
  // See docs/adr/0001.
  "main": "../dist/worker.js",
  "compatibility_date": "2026-04-20",
  "account_id": "4da88288dc30d9ee257f319d3c33ecf0",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "open-airplane.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "vars": {
    "APP_HANDLE": "open-airplane.etzhayyim.com",
    "PRIMARY_DID": "did:web:open-airplane.etzhayyim.com",
    "APP_FRAMEWORK": "cljs-esm-worker",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "observability": {
    "enabled": true
  }
}
